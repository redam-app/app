{
    "name": "redam/app",
    "description": "Relational Database Management",
    "keywords": [
        "database",
        "mysql",
        "mariadb"
    ],
    "homepage": "https://redam.app",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/redam-app/app/issues",
        "source": "https://github.com/redam-app/app"
    },
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev"
        }
    ],
    "require": {
        "php": "^8.0",
        "fewedev/base": "^2.2",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "matomo/ini": "^3.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "redam"
    ],
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix app",
        "cs": "vendor/bin/php-cs-fixer fix app --dry-run --verbose --diff",
        "ps": "vendor/bin/phpstan analyse"
    }
}
